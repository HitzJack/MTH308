#include <iostream>

using namespace std;


#define N 3 // Matrix size

// Function to calculate determinant of a 3x3 matrix
double determinant(double matrix[N][N]) {
    return matrix[0][0] * (matrix[1][1] * matrix[2][2] - matrix[1][2] * matrix[2][1])
         - matrix[0][1] * (matrix[1][0] * matrix[2][2] - matrix[1][2] * matrix[2][0])
         + matrix[0][2] * (matrix[1][0] * matrix[2][1] - matrix[1][1] * matrix[2][0]);
}

// Function to compute cofactor matrix
void cofactorMatrix(double matrix[N][N], double cofactors[N][N]) {
    cofactors[0][0] =  (matrix[1][1] * matrix[2][2] - matrix[1][2] * matrix[2][1]);
    cofactors[0][1] = -(matrix[1][0] * matrix[2][2] - matrix[1][2] * matrix[2][0]);
    cofactors[0][2] =  (matrix[1][0] * matrix[2][1] - matrix[1][1] * matrix[2][0]);

    cofactors[1][0] = -(matrix[0][1] * matrix[2][2] - matrix[0][2] * matrix[2][1]);
    cofactors[1][1] =  (matrix[0][0] * matrix[2][2] - matrix[0][2] * matrix[2][0]);
    cofactors[1][2] = -(matrix[0][0] * matrix[2][1] - matrix[0][1] * matrix[2][0]);

    cofactors[2][0] =  (matrix[0][1] * matrix[1][2] - matrix[0][2] * matrix[1][1]);
    cofactors[2][1] = -(matrix[0][0] * matrix[1][2] - matrix[0][2] * matrix[1][0]);
    cofactors[2][2] =  (matrix[0][0] * matrix[1][1] - matrix[0][1] * matrix[1][0]);
}

// Function to compute adjugate (transpose of cofactor matrix)
void adjugateMatrix(double cofactors[N][N], double adj[N][N]) {
    // Transpose of cofactor matrix
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            adj[i][j] = cofactors[j][i];
        }
    }
}

// Function to calculate inverse
bool inverseMatrix(double matrix[N][N], double inverse[N][N]) {
    double det = determinant(matrix);
    
    if (det == 0) {
        cout << "Matrix is singular, cannot find inverse.\n";
        return false;
    }

    double cofactors[N][N], adj[N][N];

    cofactorMatrix(matrix, cofactors);
    adjugateMatrix(cofactors, adj);

    // Multiply adjugate matrix by 1/det(A)
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            inverse[i][j] = adj[i][j] / det;
        }
    }
    return true;
}

// Function to display a matrix
void displayMatrix(double matrix[N][N]) {
    for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
            cout << matrix[i][j] << "\t";
        }
        cout << endl;
    }
}

int main() {
    double matrix[N][N] = {
        {2, -1, 1},
        {1,  3, 2},
        {1, -1, 2}
    };

    double inverse[N][N];

    cout << "Original Matrix:\n";
    displayMatrix(matrix);

    if (inverseMatrix(matrix, inverse)) {
        cout << "\nInverse Matrix:\n";
        displayMatrix(inverse);
    }

    return 0;
}

#include <iostream>
#include <vector>
#include <cmath>

using namespace std;

typedef vector<vector<double>> Matrix;
typedef vector<double> Vector;

// Function to perform LU decomposition
void luDecomposition(const Matrix &A, Matrix &L, Matrix &U, int n) {
    for (int i = 0; i < n; i++) {
        for (int j = i; j < n; j++) {
            U[i][j] = A[i][j];
            for (int k = 0; k < i; k++) {
                U[i][j] -= L[i][k] * U[k][j];
            }
        }
        for (int j = i; j < n; j++) {
            if (i == j)
                L[i][j] = 1;
            else {
                L[j][i] = A[j][i];
                for (int k = 0; k < i; k++) {
                    L[j][i] -= L[j][k] * U[k][i];
                }
                L[j][i] /= U[i][i];
            }
        }
    }
}

// Forward substitution to solve Ly = b
Vector forwardSubstitution(const Matrix &L, const Vector &b, int n) {
    Vector y(n, 0);
    for (int i = 0; i < n; i++) {
        y[i] = b[i];
        for (int j = 0; j < i; j++) {
            y[i] -= L[i][j] * y[j];
        }
    }
    return y;
}

// Backward substitution to solve Ux = y
Vector backwardSubstitution(const Matrix &U, const Vector &y, int n) {
    Vector x(n, 0);
    for (int i = n - 1; i >= 0; i--) {
        x[i] = y[i];
        for (int j = i + 1; j < n; j++) {
            x[i] -= U[i][j] * x[j];
        }
        x[i] /= U[i][i];
    }
    return x;
}

// Function to solve Ax = b using LU decomposition
Vector solveLU(const Matrix &A, const Vector &b, int n) {
    Matrix L(n, Vector(n, 0)), U(n, Vector(n, 0));
    luDecomposition(A, L, U, n);
    
    Vector y = forwardSubstitution(L, b, n);
    Vector x = backwardSubstitution(U, y, n);
    
    // Print L matrix
    cout << "L matrix:" << endl;
    for (const auto &row : L) {
        for (double val : row) cout << val << " ";
        cout << endl;
    }
    
    // Print U matrix
    cout << "U matrix:" << endl;
    for (const auto &row : U) {
        for (double val : row) cout << val << " ";
        cout << endl;
    }
    
    return x;
}

int main() {
    Matrix A = {{4, 3}, {6, 3}};
    Vector b = {10, 12};
    int n = A.size();

    Vector x = solveLU(A, b, n);
    
    cout << "Solution x:" << endl;
    for (double val : x) cout << val << " ";
    cout << endl;

    return 0;
}

